{
  "name": "Webhook Verify GET (Meta WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-respostas",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "v1",
      "name": "Webhook GET (mesmo path)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "whatsapp-respostas-get",
      "notes": "Use o MESMO path do webhook POST do Fluxo C (ex.: 'whatsapp-respostas')."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "tok",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $env.WHATSAPP_VERIFY_TOKEN }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "v2",
      "name": "IF token confere?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": { "responseCode": 200 }
      },
      "id": "v3",
      "name": "Responder challenge (200)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 200]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "forbidden",
        "options": { "responseCode": 403 }
      },
      "id": "v4",
      "name": "Responder 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 400]
    }
  ],
  "connections": {
    "Webhook GET (mesmo path)": { "main": [[{ "node": "IF token confere?", "type": "main", "index": 0 }]] },
    "IF token confere?": {
      "main": [
        [{ "node": "Responder challenge (200)", "type": "main", "index": 0 }],
        [{ "node": "Responder 403", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
